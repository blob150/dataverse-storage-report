        "Get_tenant_Database": {
          "type": "Http",
          "inputs": {
            "uri": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', parameters('DSR Tenant ID (dsr_TenantId)'), '/entitlements/Database')}",
            "method": "GET",
            "authentication": {
