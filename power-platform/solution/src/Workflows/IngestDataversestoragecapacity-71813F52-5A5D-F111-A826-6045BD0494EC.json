            "Filter_Log": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body('Parse_Log_entitlement')?['value'], json('[]'))",
                "where": "@equals(toLower(item()?['environmentId']), toLower(items('For_each_environment')?['name']))"
              },
              "runAfter": {
                "Parse_Log_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000222"
              }
            },
            "If_owner_id_present": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@coalesce(items('For_each_environment')?['properties']?['createdBy']?['id'], '')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_owner_user": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', items('For_each_environment')?['properties']?['createdBy']?['id'], '?$select=displayName,mail,userPrincipalName')}",
                    "method": "GET",
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "https://login.microsoftonline.com",
                      "tenant": "@{parameters('DSR Tenant ID (dsr_TenantId)')}",
                      "audience": "https://graph.microsoft.com",
                      "clientId": "@{parameters('DSR Admin Client ID (dsr_AdminClientId)')}",
                      "secret": "@{outputs('Perform_an_unbound_action')?['body/EnvironmentVariableSecretValue']}"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
