        "Add_tenant_pool_snapshot": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "dsr_tenantpools",
              "item/dsr_availablegb": "@{div(mul(add(add(coalesce(body('Parse_tenant_Database')?['entitlement']?['capacity']?['availableQuantity'], 0), coalesce(body('Parse_tenant_File')?['entitlement']?['capacity']?['availableQuantity'], 0)), coalesce(body('Parse_tenant_Log')?['entitlement']?['capacity']?['availableQuantity'], 0)), 1.0), 1024.0)}",
              "item/dsr_capturedat": "@{utcNow()}",
              "item/dsr_name": "Tenant pool @{utcNow()}",
              "item/dsr_paygoaccrualgb": "@{div(mul(add(add(coalesce(body('Parse_tenant_Database')?['entitlement']?['payGo']?['consumed']?['value'], 0), coalesce(body('Parse_tenant_File')?['entitlement']?['payGo']?['consumed']?['value'], 0)), coalesce(body('Parse_tenant_Log')?['entitlement']?['payGo']?['consumed']?['value'], 0)), 1.0), 1024.0)}",
              "item/dsr_totalallocatedgb": "@{div(mul(add(add(coalesce(body('Parse_tenant_Database')?['entitlement']?['capacity']?['allocated']?['value'], 0), coalesce(body('Parse_tenant_File')?['entitlement']?['capacity']?['allocated']?['value'], 0)), coalesce(body('Parse_tenant_Log')?['entitlement']?['capacity']?['allocated']?['value'], 0)), 1.0), 1024.0)}",
              "item/dsr_totalusedgb": "@{div(mul(add(add(coalesce(body('Parse_tenant_Database')?['entitlement']?['capacity']?['consumed']?['value'], 0), coalesce(body('Parse_tenant_File')?['entitlement']?['capacity']?['consumed']?['value'], 0)), coalesce(body('Parse_tenant_Log')?['entitlement']?['capacity']?['consumed']?['value'], 0)), 1.0), 1024.0)}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {
            "Parse_tenant_Database": [
              "Succeeded"
            ],
            "Parse_tenant_File": [
              "Succeeded"
            ],
            "Parse_tenant_Log": [
