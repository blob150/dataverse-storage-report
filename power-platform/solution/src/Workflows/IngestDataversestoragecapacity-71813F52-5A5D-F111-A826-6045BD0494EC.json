          "metadata": {
            "schemaName": "dsr_BapApiVersion",
            "description": "api-version query string for BAP admin endpoints."
          }
        },
        "DSR History Retention Days (dsr_HistoryRetentionDays)": {
          "defaultValue": 90,
          "type": "Int",
          "metadata": {
            "schemaName": "dsr_HistoryRetentionDays",
            "description": "Days of dsr_storagesnapshot history to retain. Older rows are pruned by the ingest flow."
          }
        }
