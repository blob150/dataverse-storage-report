          "metadata": {
            "schemaName": "dsr_TenantId",
            "description": "Azure AD tenant GUID used to acquire BAP admin tokens."
          }
        },
        "DSR Admin Client ID (dsr_AdminClientId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_AdminClientId",
            "description": "App registration (service principal) client ID used to call BAP admin APIs."
          }
        },
        "DSR BAP API Version (dsr_BapApiVersion)": {
          "defaultValue": "2020-10-01",
