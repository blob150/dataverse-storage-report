          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000021"
          }
        },
        "For_each_environment": {
          "type": "Foreach",
          "foreach": "@body('Parse_environments_response')?['value']",
          "actions": {
            "Upsert_environment": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "dsr_environments",
                  "recordId": "@{if(startsWith(items('For_each_environment')?['name'], 'Default-'), substring(items('For_each_environment')?['name'], 8, sub(length(items('For_each_environment')?['name']), 8)), items('For_each_environment')?['name'])}",
                  "item/dsr_billingmodel": "@{if(equals(items('For_each_environment')?['properties']?['billingPolicy']?['billingPolicyType'], 'PayAsYouGo'), 'PayAsYouGo', 'License')}",
                  "item/dsr_displayname": "@{items('For_each_environment')?['properties']?['displayName']}",
                  "item/dsr_environmentguid": "@{items('For_each_environment')?['name']}",
                  "item/dsr_name": "@{items('For_each_environment')?['properties']?['displayName']}",
                  "item/dsr_owneremail": "@{coalesce(body('Parse_owner_user')?['mail'], body('Parse_owner_user')?['userPrincipalName'], 'System')}",
                  "item/dsr_ownername": "@{coalesce(body('Parse_owner_user')?['displayName'], 'System')}",
                  "item/dsr_paygosubscriptionid": "@{items('For_each_environment')?['properties']?['billingPolicy']?['azureSubscriptionId']}",
                  "item/dsr_region": "@{items('For_each_environment')?['properties']?['azureRegion']}",
                  "item/dsr_type": "@{items('For_each_environment')?['properties']?['environmentSku']}",
                  "item/dsr_url": "@{items('For_each_environment')?['properties']?['linkedEnvironmentMetadata']?['instanceUrl']}"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "If_owner_id_present": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000033"
              }
            },
            "Add_storage_snapshot": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "dsr_storagesnapshots",
                  "item/dsr_capturedat": "@{utcNow()}",
                  "item/dsr_dballocatedgb": "@div(mul(coalesce(first(body('Filter_Database'))?['entitlement']?['capacity']?['allocated']?['value'], 0), 1.0), 1024.0)",
                  "item/dsr_dbusedgb": "@div(mul(coalesce(first(body('Filter_Database'))?['entitlement']?['capacity']?['consumed']?['value'], 0), 1.0), 1024.0)",
                  "item/dsr_Environment@odata.bind": "/dsr_environments(@{if(startsWith(items('For_each_environment')?['name'], 'Default-'), substring(items('For_each_environment')?['name'], 8, sub(length(items('For_each_environment')?['name']), 8)), items('For_each_environment')?['name'])})",
                  "item/dsr_fileallocatedgb": "@div(mul(coalesce(first(body('Filter_File'))?['entitlement']?['capacity']?['allocated']?['value'], 0), 1.0), 1024.0)",
                  "item/dsr_fileusedgb": "@div(mul(coalesce(first(body('Filter_File'))?['entitlement']?['capacity']?['consumed']?['value'], 0), 1.0), 1024.0)",
                  "item/dsr_logallocatedgb": "@div(mul(coalesce(first(body('Filter_Log'))?['entitlement']?['capacity']?['allocated']?['value'], 0), 1.0), 1024.0)",
                  "item/dsr_logusedgb": "@div(mul(coalesce(first(body('Filter_Log'))?['entitlement']?['capacity']?['consumed']?['value'], 0), 1.0), 1024.0)",
                  "item/dsr_name": "@{items('For_each_environment')?['properties']?['displayName']} @{utcNow()}",
                  "item/dsr_overagegb": "@div(mul(add(add(if(less(coalesce(first(body('Filter_Database'))?['entitlement']?['capacity']?['availableQuantity'], 0), 0), mul(coalesce(first(body('Filter_Database'))?['entitlement']?['capacity']?['availableQuantity'], 0), -1), 0), if(less(coalesce(first(body('Filter_File'))?['entitlement']?['capacity']?['availableQuantity'], 0), 0), mul(coalesce(first(body('Filter_File'))?['entitlement']?['capacity']?['availableQuantity'], 0), -1), 0)), if(less(coalesce(first(body('Filter_Log'))?['entitlement']?['capacity']?['availableQuantity'], 0), 0), mul(coalesce(first(body('Filter_Log'))?['entitlement']?['capacity']?['availableQuantity'], 0), -1), 0)), 1.0), 1024.0)",
                  "item/dsr_paygoconsumptiongb": "@div(mul(add(add(coalesce(first(body('Filter_Database'))?['entitlement']?['payGo']?['consumed']?['value'], 0), coalesce(first(body('Filter_File'))?['entitlement']?['payGo']?['consumed']?['value'], 0)), coalesce(first(body('Filter_Log'))?['entitlement']?['payGo']?['consumed']?['value'], 0)), 1.0), 1024.0)",
                  "item/dsr_paygoenabled": "@or(or(greater(coalesce(first(body('Filter_Database'))?['entitlement']?['payGo']?['entitled']?['value'], 0), 0), greater(coalesce(first(body('Filter_File'))?['entitlement']?['payGo']?['entitled']?['value'], 0), 0)), greater(coalesce(first(body('Filter_Log'))?['entitlement']?['payGo']?['entitled']?['value'], 0), 0))"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Upsert_environment": [
                  "Succeeded"
                ],
                "Filter_Database": [
                  "Succeeded"
                ],
                "Filter_File": [
                  "Succeeded"
                ],
                "Filter_Log": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000034"
              }
            },
            "Get_Database_entitlement": {
              "type": "Http",
              "inputs": {
                "uri": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', parameters('DSR Tenant ID (dsr_TenantId)'), '/environments/entitlements/Database?searchRequest=', encodeUriComponent(items('For_each_environment')?['properties']?['displayName']))}",
                "method": "GET",
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@{parameters('DSR Tenant ID (dsr_TenantId)')}",
                  "audience": "https://licensing.powerplatform.microsoft.com/",
                  "clientId": "@{parameters('DSR Admin Client ID (dsr_AdminClientId)')}",
                  "secret": "@{outputs('Perform_an_unbound_action')?['body/EnvironmentVariableSecretValue']}"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000200"
