            "Get_Log_entitlement": {
              "type": "Http",
              "inputs": {
                "uri": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', parameters('DSR Tenant ID (dsr_TenantId)'), '/environments/entitlements/Log?searchRequest=', encodeUriComponent(items('For_each_environment')?['properties']?['displayName']))}",
                "method": "GET",
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@{parameters('DSR Tenant ID (dsr_TenantId)')}",
                  "audience": "https://licensing.powerplatform.microsoft.com/",
                  "clientId": "@{parameters('DSR Admin Client ID (dsr_AdminClientId)')}",
                  "secret": "@{outputs('Perform_an_unbound_action')?['body/EnvironmentVariableSecretValue']}"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000202"
              }
            },
            "Parse_Log_entitlement": {
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Get_Log_entitlement')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Log_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000212"
              }
