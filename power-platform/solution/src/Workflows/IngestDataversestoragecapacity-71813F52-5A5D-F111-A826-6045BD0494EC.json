            "Filter_File": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body('Parse_File_entitlement')?['value'], json('[]'))",
                "where": "@equals(toLower(item()?['environmentId']), toLower(items('For_each_environment')?['name']))"
              },
              "runAfter": {
                "Parse_File_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000221"
