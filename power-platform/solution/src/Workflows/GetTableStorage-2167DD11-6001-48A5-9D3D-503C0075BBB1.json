{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "dsr_shareddataverse"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "DSR Tenant ID (dsr_TenantId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_TenantId",
            "description": "Azure AD tenant GUID used to acquire licensing API admin tokens."
          }
        },
        "DSR Admin Client ID (dsr_AdminClientId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_AdminClientId",
            "description": "App registration (service principal) client ID used to call the licensing API."
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "envId": {
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "title": "envId",
                  "description": "Power Platform environment GUID."
                },
                "dimension": {
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "title": "dimension",
                  "description": "Storage dimension: Database | File | Log."
                },
                "search": {
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "title": "search",
                  "description": "Substring filter over resourceId. Empty for no filter."
                }
              },
              "required": [
                "envId",
                "dimension"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000001"
          }
        }
      },
      "actions": {
        "Perform_an_unbound_action": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "actionName": "RetrieveEnvironmentVariableSecretValue",
              "item/EnvironmentVariableName": "dsr_AdminClientSecret"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "PerformUnboundAction",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {},
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "outputs"
              ]
            }
          }
        },
        "Get_resources": {
          "type": "Http",
          "inputs": {
            "uri": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', parameters('DSR Tenant ID (dsr_TenantId)'), '/entitlements/', triggerBody()?['dimension'], '/environments/', triggerBody()?['envId'], '/resources?skip=0&filter=contains(resourceId,''', encodeUriComponent(coalesce(triggerBody()?['search'], '')), ''')&orderby=consumed desc')}",
            "method": "GET",
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "https://login.microsoftonline.com",
              "tenant": "@{parameters('DSR Tenant ID (dsr_TenantId)')}",
              "audience": "https://licensing.powerplatform.microsoft.com/",
              "clientId": "@{parameters('DSR Admin Client ID (dsr_AdminClientId)')}",
              "secret": "@{outputs('Perform_an_unbound_action')?['body/EnvironmentVariableSecretValue']}"
            }
          },
          "runAfter": {
            "Perform_an_unbound_action": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000010"
          }
        },
        "Respond_success": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "body": {
                  "title": "body",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            },
            "body": {
              "body": "@{string(body('Get_resources'))}"
            }
          },
          "runAfter": {
            "Get_resources": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000020"
          }
        },
        "Respond_error": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 502,
            "schema": {
              "type": "object",
              "properties": {
                "body": {
                  "title": "body",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            },
            "body": {
              "body": "@{concat('{\"error\":{\"message\":\"Licensing service call failed (status ', string(outputs('Get_resources')?['statusCode']), ')\",\"upstream\":', string(body('Get_resources')), '}}')}"
            }
          },
          "runAfter": {
            "Get_resources": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000021"
          }
        }
      },
      "outputs": {},
      "description": "On-demand per-table storage passthrough. Invoked by the Dataverse Storage Report code app via a PowerAppV2 trigger (caller-authenticated: only app users can call it). Forwards to https://licensing.powerplatform.microsoft.com/.../entitlements/{Database|File|Log}/environments/{envId}/resources using the DSR Admin App service principal. Returns the response body as a single string field so it can be parsed on the caller side. Does NOT write anything to Dataverse."
    }
  },
  "schemaVersion": "1.0.0.0"
}
