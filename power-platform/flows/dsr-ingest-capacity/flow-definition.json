{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "dsr_shareddataverse"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "DSR Tenant ID (dsr_TenantId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_TenantId",
            "description": "Azure AD tenant GUID used to acquire BAP admin tokens."
          }
        },
        "DSR Admin Client ID (dsr_AdminClientId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_AdminClientId",
            "description": "App registration (service principal) client ID used to call BAP admin APIs."
          }
        },
        "DSR BAP API Version (dsr_BapApiVersion)": {
          "defaultValue": "2020-10-01",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_BapApiVersion",
            "description": "api-version query string for BAP admin endpoints."
          }
        },
        "DSR History Retention Days (dsr_HistoryRetentionDays)": {
          "defaultValue": 90,
          "type": "Int",
          "metadata": {
            "schemaName": "dsr_HistoryRetentionDays",
            "description": "Days of dsr_storagesnapshot history to retain. Older rows are pruned by the ingest flow."
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "2026-05-28T08:00:00Z",
            "timeZone": "Eastern Standard Time",
            "schedule": {
              "hours": [
                "4"
              ],
              "minutes": [
                0
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000001"
          }
        }
      },
      "actions": {
        "List_environments": {
          "type": "Http",
          "inputs": {
            "uri": "https://api.bap.microsoft.com/providers/Microsoft.BusinessAppPlatform/scopes/admin/environments?api-version=@{parameters(\u0027DSR BAP API Version (dsr_BapApiVersion)\u0027)}",
            "method": "GET",
            "authentication": {
              "type": "ActiveDirectoryOAuth",
              "authority": "https://login.microsoftonline.com",
              "tenant": "@{parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027)}",
              "audience": "https://api.bap.microsoft.com/",
              "clientId": "@{parameters(\u0027DSR Admin Client ID (dsr_AdminClientId)\u0027)}",
              "secret": "@{outputs(\u0027Perform_an_unbound_action\u0027)?[\u0027body/EnvironmentVariableSecretValue\u0027]}"
            }
          },
          "runAfter": {
            "Perform_an_unbound_action": [
              "SUCCEEDED"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000020"
          }
        },
        "Parse_environments_response": {
          "type": "ParseJson",
          "inputs": {
            "content": "@body(\u0027List_environments\u0027)",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "properties": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "List_environments": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000021"
          }
        },
        "For_each_environment": {
          "type": "Foreach",
          "foreach": "@body(\u0027Parse_environments_response\u0027)?[\u0027value\u0027]",
          "actions": {
            "Upsert_environment": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "dsr_environments",
                  "recordId": "@{if(startsWith(items(\u0027For_each_environment\u0027)?[\u0027name\u0027], \u0027Default-\u0027), substring(items(\u0027For_each_environment\u0027)?[\u0027name\u0027], 8, sub(length(items(\u0027For_each_environment\u0027)?[\u0027name\u0027]), 8)), items(\u0027For_each_environment\u0027)?[\u0027name\u0027])}",
                  "item/dsr_billingmodel": "@{if(equals(items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027billingPolicy\u0027]?[\u0027billingPolicyType\u0027], \u0027PayAsYouGo\u0027), \u0027PayAsYouGo\u0027, \u0027License\u0027)}",
                  "item/dsr_displayname": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027displayName\u0027]}",
                  "item/dsr_environmentguid": "@{items(\u0027For_each_environment\u0027)?[\u0027name\u0027]}",
                  "item/dsr_name": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027displayName\u0027]}",
                  "item/dsr_owneremail": "@{coalesce(body(\u0027Parse_owner_user\u0027)?[\u0027mail\u0027], body(\u0027Parse_owner_user\u0027)?[\u0027userPrincipalName\u0027], \u0027System\u0027)}",
                  "item/dsr_ownername": "@{coalesce(body(\u0027Parse_owner_user\u0027)?[\u0027displayName\u0027], \u0027System\u0027)}",
                  "item/dsr_paygosubscriptionid": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027billingPolicy\u0027]?[\u0027azureSubscriptionId\u0027]}",
                  "item/dsr_region": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027azureRegion\u0027]}",
                  "item/dsr_type": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027environmentSku\u0027]}",
                  "item/dsr_url": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027linkedEnvironmentMetadata\u0027]?[\u0027instanceUrl\u0027]}"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "If_owner_id_present": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000033"
              }
            },
            "Add_storage_snapshot": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "dsr_storagesnapshots",
                  "item/dsr_capturedat": "@{utcNow()}",
                  "item/dsr_dballocatedgb": "@div(mul(coalesce(first(body(\u0027Filter_Database\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027allocated\u0027]?[\u0027value\u0027], 0), 1.0), 1024.0)",
                  "item/dsr_dbusedgb": "@div(mul(coalesce(first(body(\u0027Filter_Database\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027consumed\u0027]?[\u0027value\u0027], 0), 1.0), 1024.0)",
                  "item/dsr_Environment@odata.bind": "/dsr_environments(@{if(startsWith(items(\u0027For_each_environment\u0027)?[\u0027name\u0027], \u0027Default-\u0027), substring(items(\u0027For_each_environment\u0027)?[\u0027name\u0027], 8, sub(length(items(\u0027For_each_environment\u0027)?[\u0027name\u0027]), 8)), items(\u0027For_each_environment\u0027)?[\u0027name\u0027])})",
                  "item/dsr_fileallocatedgb": "@div(mul(coalesce(first(body(\u0027Filter_File\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027allocated\u0027]?[\u0027value\u0027], 0), 1.0), 1024.0)",
                  "item/dsr_fileusedgb": "@div(mul(coalesce(first(body(\u0027Filter_File\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027consumed\u0027]?[\u0027value\u0027], 0), 1.0), 1024.0)",
                  "item/dsr_logallocatedgb": "@div(mul(coalesce(first(body(\u0027Filter_Log\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027allocated\u0027]?[\u0027value\u0027], 0), 1.0), 1024.0)",
                  "item/dsr_logusedgb": "@div(mul(coalesce(first(body(\u0027Filter_Log\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027consumed\u0027]?[\u0027value\u0027], 0), 1.0), 1024.0)",
                  "item/dsr_name": "@{items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027displayName\u0027]} @{utcNow()}",
                  "item/dsr_overagegb": "@div(mul(add(add(if(less(coalesce(first(body(\u0027Filter_Database\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), 0), mul(coalesce(first(body(\u0027Filter_Database\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), -1), 0), if(less(coalesce(first(body(\u0027Filter_File\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), 0), mul(coalesce(first(body(\u0027Filter_File\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), -1), 0)), if(less(coalesce(first(body(\u0027Filter_Log\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), 0), mul(coalesce(first(body(\u0027Filter_Log\u0027))?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), -1), 0)), 1.0), 1024.0)",
                  "item/dsr_paygoconsumptiongb": "@div(mul(add(add(coalesce(first(body(\u0027Filter_Database\u0027))?[\u0027entitlement\u0027]?[\u0027payGo\u0027]?[\u0027consumed\u0027]?[\u0027value\u0027], 0), coalesce(first(body(\u0027Filter_File\u0027))?[\u0027entitlement\u0027]?[\u0027payGo\u0027]?[\u0027consumed\u0027]?[\u0027value\u0027], 0)), coalesce(first(body(\u0027Filter_Log\u0027))?[\u0027entitlement\u0027]?[\u0027payGo\u0027]?[\u0027consumed\u0027]?[\u0027value\u0027], 0)), 1.0), 1024.0)",
                  "item/dsr_paygoenabled": "@or(or(greater(coalesce(first(body(\u0027Filter_Database\u0027))?[\u0027entitlement\u0027]?[\u0027payGo\u0027]?[\u0027entitled\u0027]?[\u0027value\u0027], 0), 0), greater(coalesce(first(body(\u0027Filter_File\u0027))?[\u0027entitlement\u0027]?[\u0027payGo\u0027]?[\u0027entitled\u0027]?[\u0027value\u0027], 0), 0)), greater(coalesce(first(body(\u0027Filter_Log\u0027))?[\u0027entitlement\u0027]?[\u0027payGo\u0027]?[\u0027entitled\u0027]?[\u0027value\u0027], 0), 0))"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Upsert_environment": [
                  "Succeeded"
                ],
                "Filter_Database": [
                  "Succeeded"
                ],
                "Filter_File": [
                  "Succeeded"
                ],
                "Filter_Log": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000034"
              }
            },
            "Get_Database_entitlement": {
              "type": "Http",
              "inputs": {
                "uri": "@{concat(\u0027https://licensing.powerplatform.microsoft.com/v2.0/tenants/\u0027, parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027), \u0027/environments/entitlements/Database?searchRequest=\u0027, encodeUriComponent(items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027displayName\u0027]))}",
                "method": "GET",
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@{parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027)}",
                  "audience": "https://licensing.powerplatform.microsoft.com/",
                  "clientId": "@{parameters(\u0027DSR Admin Client ID (dsr_AdminClientId)\u0027)}",
                  "secret": "@{outputs(\u0027Perform_an_unbound_action\u0027)?[\u0027body/EnvironmentVariableSecretValue\u0027]}"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000200"
              }
            },
            "Parse_Database_entitlement": {
              "type": "ParseJson",
              "inputs": {
                "content": "@body(\u0027Get_Database_entitlement\u0027)",
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Database_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000210"
              }
            },
            "Filter_Database": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body(\u0027Parse_Database_entitlement\u0027)?[\u0027value\u0027], json(\u0027[]\u0027))",
                "where": "@equals(toLower(item()?[\u0027environmentId\u0027]), toLower(items(\u0027For_each_environment\u0027)?[\u0027name\u0027]))"
              },
              "runAfter": {
                "Parse_Database_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000220"
              }
            },
            "Get_File_entitlement": {
              "type": "Http",
              "inputs": {
                "uri": "@{concat(\u0027https://licensing.powerplatform.microsoft.com/v2.0/tenants/\u0027, parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027), \u0027/environments/entitlements/File?searchRequest=\u0027, encodeUriComponent(items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027displayName\u0027]))}",
                "method": "GET",
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@{parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027)}",
                  "audience": "https://licensing.powerplatform.microsoft.com/",
                  "clientId": "@{parameters(\u0027DSR Admin Client ID (dsr_AdminClientId)\u0027)}",
                  "secret": "@{outputs(\u0027Perform_an_unbound_action\u0027)?[\u0027body/EnvironmentVariableSecretValue\u0027]}"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000201"
              }
            },
            "Parse_File_entitlement": {
              "type": "ParseJson",
              "inputs": {
                "content": "@body(\u0027Get_File_entitlement\u0027)",
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_File_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000211"
              }
            },
            "Filter_File": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body(\u0027Parse_File_entitlement\u0027)?[\u0027value\u0027], json(\u0027[]\u0027))",
                "where": "@equals(toLower(item()?[\u0027environmentId\u0027]), toLower(items(\u0027For_each_environment\u0027)?[\u0027name\u0027]))"
              },
              "runAfter": {
                "Parse_File_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000221"
              }
            },
            "Get_Log_entitlement": {
              "type": "Http",
              "inputs": {
                "uri": "@{concat(\u0027https://licensing.powerplatform.microsoft.com/v2.0/tenants/\u0027, parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027), \u0027/environments/entitlements/Log?searchRequest=\u0027, encodeUriComponent(items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027displayName\u0027]))}",
                "method": "GET",
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "authority": "https://login.microsoftonline.com",
                  "tenant": "@{parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027)}",
                  "audience": "https://licensing.powerplatform.microsoft.com/",
                  "clientId": "@{parameters(\u0027DSR Admin Client ID (dsr_AdminClientId)\u0027)}",
                  "secret": "@{outputs(\u0027Perform_an_unbound_action\u0027)?[\u0027body/EnvironmentVariableSecretValue\u0027]}"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000202"
              }
            },
            "Parse_Log_entitlement": {
              "type": "ParseJson",
              "inputs": {
                "content": "@body(\u0027Get_Log_entitlement\u0027)",
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Log_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000212"
              }
            },
            "Filter_Log": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body(\u0027Parse_Log_entitlement\u0027)?[\u0027value\u0027], json(\u0027[]\u0027))",
                "where": "@equals(toLower(item()?[\u0027environmentId\u0027]), toLower(items(\u0027For_each_environment\u0027)?[\u0027name\u0027]))"
              },
              "runAfter": {
                "Parse_Log_entitlement": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000222"
              }
            },
            "If_owner_id_present": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@coalesce(items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027createdBy\u0027]?[\u0027id\u0027], \u0027\u0027)",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_owner_user": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{concat(\u0027https://graph.microsoft.com/v1.0/users/\u0027, items(\u0027For_each_environment\u0027)?[\u0027properties\u0027]?[\u0027createdBy\u0027]?[\u0027id\u0027], \u0027?$select=displayName,mail,userPrincipalName\u0027)}",
                    "method": "GET",
                    "authentication": {
                      "type": "ActiveDirectoryOAuth",
                      "authority": "https://login.microsoftonline.com",
                      "tenant": "@{parameters(\u0027DSR Tenant ID (dsr_TenantId)\u0027)}",
                      "audience": "https://graph.microsoft.com",
                      "clientId": "@{parameters(\u0027DSR Admin Client ID (dsr_AdminClientId)\u0027)}",
                      "secret": "@{outputs(\u0027Perform_an_unbound_action\u0027)?[\u0027body/EnvironmentVariableSecretValue\u0027]}"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  },
                  "metadata": {
                    "operationMetadataId": "00000000-0000-0000-0000-000000000301"
                  }
                },
                "Parse_owner_user": {
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@coalesce(body(\u0027Get_owner_user\u0027), json(\u0027{}\u0027))",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "displayName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "mail": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "userPrincipalName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Get_owner_user": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "00000000-0000-0000-0000-000000000302"
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "metadata": {
                "operationMetadataId": "00000000-0000-0000-0000-000000000300"
              }
            }
          },
          "runAfter": {
            "Parse_environments_response": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 20
            }
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000030"
          }
        },
        "Add_tenant_pool_snapshot": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "dsr_tenantpools",
              "item/dsr_availablegb": "@{div(mul(add(add(coalesce(body(\u0027Parse_tenant_Database\u0027)?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0), coalesce(body(\u0027Parse_tenant_File\u0027)?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0)), coalesce(body(\u0027Parse_tenant_Log\u0027)?[\u0027entitlement\u0027]?[\u0027capacity\u0027]?[\u0027availableQuantity\u0027], 0)), 1.0), 1024.0)}",
              "item/dsr_capturedat": "@{utcNow()}",
              "item/dsr_name": "Tenant pool @{utcNow()}",
