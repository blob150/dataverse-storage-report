{
  "name": "Ingest Dataverse storage capacity",
  "description": "Pulls per-environment Dataverse capacity (Database, File, Log) and PayGo consumption from the Power Platform BAP admin APIs, plus tenant pool totals, and upserts dsr_environment / dsr_storagesnapshot / dsr_tenantpool rows.",
  "state": "DisabledUntilConnectionsAreConfigured",
  "triggers": [
    {
      "type": "Recurrence",
      "frequency": "Day",
      "interval": 1,
      "startTime": "T03:00:00"
    },
    {
      "type": "Request",
      "kind": "Http",
      "description": "HTTP-triggered for the 'Refresh now' button in the code app. Set VITE_REFRESH_FLOW_URL in the app to the URL returned after the flow is saved."
    }
  ],
  "connectionReferences": {
    "shared_commondataserviceforapps": {
      "displayName": "Dataverse",
      "placeholder": "Connect with an account that can write to dsr_ tables"
    }
  },
  "environmentVariables": [
    "dsr_TenantId",
    "dsr_AdminClientId",
    "dsr_AdminClientSecret",
    "dsr_BapApiVersion",
    "dsr_HistoryRetentionDays"
  ],
  "tables": {
    "environments": "dsr_environment",
    "snapshots": "dsr_storagesnapshot",
    "tenantPool": "dsr_tenantpool"
  },
  "steps": [
    {
      "name": "Get BAP admin token",
      "type": "HTTP",
      "method": "POST",
      "uri": "https://login.microsoftonline.com/@{environment('dsr_TenantId')}/oauth2/v2.0/token",
      "headers": { "Content-Type": "application/x-www-form-urlencoded" },
      "body": "client_id=@{environment('dsr_AdminClientId')}&client_secret=@{environment('dsr_AdminClientSecret')}&scope=https%3A%2F%2Fapi.bap.microsoft.com%2F.default&grant_type=client_credentials",
      "outputAlias": "bapToken"
    },
    {
      "name": "List environments",
      "type": "HTTP",
      "method": "GET",
      "uri": "https://api.bap.microsoft.com/providers/Microsoft.BusinessAppPlatform/scopes/admin/environments?api-version=@{environment('dsr_BapApiVersion')}",
      "headers": { "Authorization": "Bearer @{body('bapToken')?['access_token']}" },
      "outputAlias": "environmentsList",
      "notes": "Response.value[].name = environment GUID; .properties.displayName, .properties.azureRegion, .properties.environmentSku, .properties.createdBy.email, .properties.createdBy.displayName, .properties.linkedEnvironmentMetadata.instanceUrl"
    },
    {
      "name": "For each environment",
      "type": "Apply to each",
      "input": "@{body('environmentsList')?['value']}",
      "steps": [
        {
          "name": "Get capacity consumption",
          "type": "HTTP",
          "method": "GET",
          "uri": "https://api.bap.microsoft.com/providers/Microsoft.BusinessAppPlatform/scopes/admin/environments/@{items('For_each_environment')?['name']}/capacityConsumption?api-version=@{environment('dsr_BapApiVersion')}",
          "headers": { "Authorization": "Bearer @{body('bapToken')?['access_token']}" },
          "outputAlias": "envCapacity",
          "notes": "Response shape varies; expected fields under .properties.dataverseCapacityConsumption: database{usedGb, allocatedGb}, file{usedGb, allocatedGb}, log{usedGb, allocatedGb}, payAsYouGo{enabled, currentConsumptionGb}, overageGb"
        },
        {
          "name": "Compose environment row",
          "type": "Compose",
          "value": {
            "dsr_environmentguid": "@{items('For_each_environment')?['name']}",
            "dsr_displayname": "@{items('For_each_environment')?['properties']?['displayName']}",
            "dsr_type": "@{items('For_each_environment')?['properties']?['environmentSku']}",
            "dsr_region": "@{items('For_each_environment')?['properties']?['azureRegion']}",
            "dsr_owneremail": "@{items('For_each_environment')?['properties']?['createdBy']?['email']}",
            "dsr_ownername": "@{items('For_each_environment')?['properties']?['createdBy']?['displayName']}",
            "dsr_billingmodel": "@{if(equals(items('For_each_environment')?['properties']?['billingPolicy']?['billingPolicyType'], 'PayAsYouGo'), 'PayAsYouGo', 'License')}",
            "dsr_paygosubscriptionid": "@{items('For_each_environment')?['properties']?['billingPolicy']?['azureSubscriptionId']}",
            "dsr_url": "@{items('For_each_environment')?['properties']?['linkedEnvironmentMetadata']?['instanceUrl']}"
          }
        },
        {
          "name": "Upsert environment (dsr_environment)",
          "connector": "Dataverse",
          "action": "Update a row (Upsert)",
          "table": "dsr_environment",
          "alternateKey": "dsr_environmentguid",
          "fields": "@{outputs('Compose_environment_row')}"
        },
        {
          "name": "Add storage snapshot (dsr_storagesnapshot)",
          "connector": "Dataverse",
          "action": "Add a new row",
          "table": "dsr_storagesnapshot",
          "fields": {
            "dsr_name": "@{items('For_each_environment')?['properties']?['displayName']} @{utcNow()}",
            "dsr_environment@odata.bind": "/dsr_environments(dsr_environmentguid='@{items('For_each_environment')?['name']}')",
            "dsr_capturedat": "@{utcNow()}",
            "dsr_dballocatedgb": "@{body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['database']?['allocatedGb']}",
            "dsr_dbusedgb": "@{body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['database']?['usedGb']}",
            "dsr_fileallocatedgb": "@{body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['file']?['allocatedGb']}",
            "dsr_fileusedgb": "@{body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['file']?['usedGb']}",
            "dsr_logallocatedgb": "@{body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['log']?['allocatedGb']}",
            "dsr_logusedgb": "@{body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['log']?['usedGb']}",
            "dsr_paygoenabled": "@{coalesce(body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['payAsYouGo']?['enabled'], false)}",
            "dsr_paygoconsumptiongb": "@{coalesce(body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['payAsYouGo']?['currentConsumptionGb'], 0)}",
            "dsr_overagegb": "@{coalesce(body('envCapacity')?['properties']?['dataverseCapacityConsumption']?['overageGb'], 0)}"
          }
        }
      ]
    },
    {
      "name": "Get tenant capacity",
      "type": "HTTP",
      "method": "GET",
      "uri": "https://api.bap.microsoft.com/providers/Microsoft.BusinessAppPlatform/scopes/admin/tenantCapacity?api-version=@{environment('dsr_BapApiVersion')}",
      "headers": { "Authorization": "Bearer @{body('bapToken')?['access_token']}" },
      "outputAlias": "tenantCapacity",
      "notes": "If the endpoint name differs in your tenant, replace with the equivalent /tenantStorageCapacity or /licenses/v1/tenants/{id}/capacity call and adjust the field paths below."
    },
    {
      "name": "Add tenant pool snapshot",
      "connector": "Dataverse",
      "action": "Add a new row",
      "table": "dsr_tenantpool",
      "fields": {
        "dsr_name": "Tenant pool @{utcNow()}",
        "dsr_capturedat": "@{utcNow()}",
        "dsr_totalallocatedgb": "@{body('tenantCapacity')?['properties']?['database']?['allocatedGb']}",
        "dsr_totalusedgb": "@{body('tenantCapacity')?['properties']?['database']?['usedGb']}",
        "dsr_availablegb": "@{sub(coalesce(body('tenantCapacity')?['properties']?['database']?['allocatedGb'],0), coalesce(body('tenantCapacity')?['properties']?['database']?['usedGb'],0))}",
        "dsr_paygoaccrualgb": "@{coalesce(body('tenantCapacity')?['properties']?['payAsYouGo']?['currentConsumptionGb'], 0)}"
      }
    },
    {
      "name": "Prune old snapshots",
      "connector": "Dataverse",
      "action": "List rows (then Delete in Apply to each)",
      "table": "dsr_storagesnapshot",
      "filter": "dsr_capturedat lt @{addDays(utcNow(), mul(-1, int(environment('dsr_HistoryRetentionDays'))))}"
    }
  ]
}
