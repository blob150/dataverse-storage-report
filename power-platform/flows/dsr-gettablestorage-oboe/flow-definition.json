{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "dsr_shareddataverse"
        },
        "runtimeSource": "embedded"
      },
      "shared_webcontents": {
        "api": {
          "name": "shared_webcontents"
        },
        "connection": {
          "connectionReferenceLogicalName": "dsr_sharedwebcontents"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "DSR Tenant ID (dsr_TenantId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "dsr_TenantId",
            "description": "Azure AD tenant GUID (kept for URI construction)."
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "envId": {
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "title": "envId",
                  "description": "Power Platform environment GUID."
                },
                "dimension": {
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "title": "dimension",
                  "description": "Storage dimension: Database | File | Log."
                },
                "search": {
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "title": "search",
                  "description": "Substring filter over resourceId. Empty for no filter."
                }
              },
              "required": [
                "envId",
                "dimension"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000001"
          }
        }
      },
      "actions": {
        "Get_resources": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Uri": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', parameters('DSR Tenant ID (dsr_TenantId)'), '/entitlements/', triggerBody()?['dimension'], '/environments/', triggerBody()?['envId'], '/resources?skip=0&filter=contains(resourceId,''', encodeUriComponent(coalesce(triggerBody()?['search'], '')), ''')&orderby=consumed desc')}",
              "Method": "GET"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
              "operationId": "InvokeHTTP",
              "connectionName": "shared_webcontents"
            }
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000010"
          }
        },
        "Respond_success": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "body": {
                  "title": "body",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            },
            "body": {
              "body": "@{string(body('Get_resources'))}"
            }
          },
          "runAfter": {
            "Get_resources": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000020"
          }
        },
        "Respond_error": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 502,
            "schema": {
              "type": "object",
              "properties": {
                "body": {
                  "title": "body",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            },
            "body": {
              "body": "@{concat('{\"error\":{\"message\":\"Licensing service call failed (status ', string(outputs('Get_resources')?['statusCode']), ')\",\"upstream\":', string(body('Get_resources')), '}}')}"
            }
          },
          "runAfter": {
            "Get_resources": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "00000000-0000-0000-0000-000000000021"
          }
        }
      },
      "outputs": {},
      "description": "OBO / Entra variant of dsr-gettablestorage. Uses the HTTP with Microsoft Entra ID (preauthorized) connector (shared_webcontents) to call licensing.powerplatform.microsoft.com using the connection user's delegated token, rather than an SP token. Bind dsr_sharedwebcontents connection reference to a Power Platform admin user before turning on. If the connection succeeds but runs fail with 403 'Insufficient privileges', an admin needs to grant the HTTP with Entra ID app the licensing.powerplatform.microsoft.com/user_impersonation scope — see https://learn.microsoft.com/connectors/webcontents/ for the ManagePermissionGrant.ps1 script."
    }
  },
  "schemaVersion": "1.0.0.0"
}
