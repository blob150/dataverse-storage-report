# Bundled code app assets inside unpacked solution (rebuilt via `pac code push` from src/)
power-platform/solution/src/CanvasApps/*_CodeAppPackages/

# Cloud flow JSON backups (auto-created by FlowProvisioner before each push)
power-platform/flows/**/backups/

# CapacityProbe log output
tools/CapacityProbe/probe*.log
tools/CapacityProbe/*.log

# Local script backups
*.bak

# pac CLI workspace
.pac/
